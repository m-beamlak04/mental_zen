rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    match /users/{uid} {

      allow read: if request.auth != null
        && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'firstName', 'lastName',
          'role', 'registrationDateTime'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'lastName',
          'role', 'registrationDateTime'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName.size() > 0
        && request.resource.data.registrationDateTime == request.time;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['firstName', 'lastName'])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName.size() > 0;

      allow delete: if false;

      match /moods/{date} {

        function validMood() {
          let data = request.resource.data;

          return data.keys().hasAll([
              'date', 'rating', 'note', 'createdAt', 'updatedAt'
            ])
            && data.keys().hasOnly([
              'date', 'rating', 'note', 'createdAt', 'updatedAt'
            ])
            && data.date is string
            && data.date == date
            && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.rating is int
            && data.rating >= 1
            && data.rating <= 5
            && (data.note == null ||
                (data.note is string && data.note.size() <= 500))
            && data.createdAt is timestamp
            && data.updatedAt == request.time;
        }

        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && validMood()
          && request.resource.data.createdAt == request.time;

        allow update: if isOwner(uid)
          && validMood()
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /journals/{entryId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.body is string;
      }

      match /reminders/{reminderId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.type is string
          && request.resource.data.hour is int
          && request.resource.data.hour >= 0
          && request.resource.data.hour <= 23
          && request.resource.data.minute is int
          && request.resource.data.minute >= 0
          && request.resource.data.minute <= 59
          && request.resource.data.enabled is bool;
      }

      match /moodSummaries/{periodId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /wellnessResources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}