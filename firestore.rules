rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    match /users/{uid} {

      allow read: if request.auth != null
        && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'firstName', 'lastName',
          'role', 'registrationDateTime'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'lastName',
          'role', 'registrationDateTime'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName.size() > 0
        && request.resource.data.registrationDateTime == request.time;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['firstName', 'lastName'])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName.size() > 0;

      allow delete: if false;

      match /moods/{date} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.date == date
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
      }

      match /journals/{entryId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.body is string;
      }

      match /reminders/{reminderId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.type is string
          && request.resource.data.hour is int
          && request.resource.data.hour >= 0
          && request.resource.data.hour <= 23
          && request.resource.data.minute is int
          && request.resource.data.minute >= 0
          && request.resource.data.minute <= 59
          && request.resource.data.enabled is bool;
      }

      match /moodSummaries/{periodId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /wellnessResources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}